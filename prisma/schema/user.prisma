enum Role {
  ADMIN
  LANDLORD
  TENANT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(TENANT)
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties     Property[]
  rentalRequests RentalRequest[]
}
